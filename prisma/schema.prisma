generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Workspace (aislamiento multi-tenant) ───────────────────────────
// Raíz de aislamiento: CLINIC = Medical Tower (institucional); BASIC = consultorio de un
// médico independiente. Usuario y Paciente son las únicas entidades con workspaceId propio;
// el resto de las tablas lo derivan por relación (asignación, paciente), igual que ya hacía
// `assertAccesoPaciente` con la propiedad del recurso antes de esta migración.

enum TipoWorkspace {
  CLINIC
  BASIC
}

enum PlanTier {
  RECETA
  CONSULTORIO
  CLINICA_PRO
}

model Workspace {
  id        String        @id @default(uuid()) @db.Uuid
  tipo      TipoWorkspace @default(CLINIC)
  plan      PlanTier      @default(RECETA)
  nombre    String
  createdAt DateTime      @default(now()) @map("created_at")

  usuarios  Usuario[]
  pacientes Paciente[]

  @@map("workspace")
}

// ─────────────────────────── Seguridad y catálogos ───────────────────────────

enum RolClave {
  ADMIN
  DOCTOR
  ENFERMERIA
  ANESTESIOLOGO
  PACIENTE
}

model Usuario {
  id             String    @id @default(uuid()) @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  workspace      Workspace @relation(fields: [workspaceId], references: [id])
  rol            RolClave
  email          String    @unique
  passwordHash   String    @map("password_hash")
  nombreCompleto String    @map("nombre_completo")
  activo         Boolean   @default(true)
  debeCambiarPassword Boolean @default(true) @map("debe_cambiar_password")
  intentosFallidos    Int      @default(0) @map("intentos_fallidos")
  bloqueadoHasta      DateTime? @map("bloqueado_hasta")
  ultimoAcceso   DateTime? @map("ultimo_acceso")
  createdAt      DateTime  @default(now()) @map("created_at")

  // Cuenta de portal del paciente: 1:1 opcional con Paciente, solo cuando rol = PACIENTE.
  pacienteId String?   @unique @map("paciente_id") @db.Uuid
  paciente   Paciente? @relation(fields: [pacienteId], references: [id])

  doctor    Doctor?
  sesiones  Session[]
  hojasCapturadas HojaPrimerLlenado[] @relation("capturista")
  notasElaboradas NotaEvolucion[]
  bitacora  Bitacora[]
  prescripciones  HojaPrescripcion[] @relation("prescriptor")
  hojasOrdenes    HojaOrdenes[]      @relation("ordenante")
  hojasConsumo    HojaConsumo[]      @relation("consumoCapturista")
  valoracionesPreanestesicas ValoracionPreanestesica[] @relation("anestesiologoValoracion")
  registrosAnestesicos       RegistroAnestesico[]      @relation("anestesiologoRegistro")
  notasPostanestesicas       NotaPostanestesica[]      @relation("anestesiologoPostanestesica")

  @@index([workspaceId])
  @@map("usuario")
}

model Session {
  id        String   @id
  usuarioId String   @map("usuario_id") @db.Uuid
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([usuarioId])
  @@map("session")
}

model Especialidad {
  id          String  @id @default(uuid()) @db.Uuid
  nombre      String  @unique
  descripcion String?
  activa      Boolean @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  doctores     DoctorEspecialidad[]
  asignaciones Asignacion[]

  @@map("especialidad")
}

model Doctor {
  id                     String  @id @default(uuid()) @db.Uuid
  usuarioId              String  @unique @map("usuario_id") @db.Uuid
  usuario                Usuario @relation(fields: [usuarioId], references: [id])
  cedulaProfesional      String  @map("cedula_profesional")
  cedulaEspecialidad     String? @map("cedula_especialidad")
  institucionTitulo      String  @map("institucion_titulo")
  universidadEspecialidad String? @map("universidad_especialidad")
  consultorio            String?
  domicilioConsultorio   String? @map("domicilio_consultorio") // domicilio completo: obligatorio en receta de médicos BASIC (RIS art. 28) cuando no hay Configuracion institucional
  telefono               String?
  firmaDigitalizada      String? @map("firma_digitalizada") // data-URL imagen rúbrica
  createdAt              DateTime @default(now()) @map("created_at")

  especialidades DoctorEspecialidad[]
  asignaciones   Asignacion[]

  @@map("doctor")
}

model DoctorEspecialidad {
  doctorId       String @map("doctor_id") @db.Uuid
  especialidadId String @map("especialidad_id") @db.Uuid
  doctor         Doctor       @relation(fields: [doctorId], references: [id])
  especialidad   Especialidad @relation(fields: [especialidadId], references: [id])

  @@id([doctorId, especialidadId])
  @@map("doctor_especialidad")
}

// ─────────────────────────── Paciente y primer llenado ───────────────────────────

model Paciente {
  id                String   @id @default(uuid()) @db.Uuid
  workspaceId       String   @map("workspace_id") @db.Uuid
  workspace         Workspace @relation(fields: [workspaceId], references: [id])
  numeroExpediente  String   @unique @map("numero_expediente")
  nombre            String
  apellidoPaterno   String   @map("apellido_paterno")
  apellidoMaterno   String?  @map("apellido_materno")
  fechaNacimiento   DateTime @map("fecha_nacimiento") @db.Date
  sexo              String   // M | F | O
  curp              String?
  tipoSangre        String?  @map("tipo_sangre")
  estadoCivil       String?  @map("estado_civil")
  ocupacion         String?
  escolaridad       String?
  religion          String?
  nacionalidad      String?
  referencia        String?  // Facebook | Instagram | Personal | Otro
  calle             String?
  colonia           String?
  municipio         String?
  estado            String?
  cp                String?
  telefono          String
  email             String?
  sinCorreo         Boolean  @default(false) @map("sin_correo")
  contactoEmergenciaNombre     String? @map("contacto_emergencia_nombre")
  contactoEmergenciaTelefono   String? @map("contacto_emergencia_telefono")
  contactoEmergenciaParentesco String? @map("contacto_emergencia_parentesco")
  derechohabiencia  String?
  activo            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")
  createdById       String?  @map("created_by") @db.Uuid

  // Portal del paciente: foto y preferencia de notificación editables por el propio
  // paciente (§5 del plan); el resto de los campos administrativos de arriba
  // (telefono, email, domicilio, contacto de emergencia) ya existían y se reutilizan.
  fotoUrl                String?  @map("foto_url") // data-URL, igual patrón que Doctor.firmaDigitalizada
  prefNotificacionEmail  Boolean  @default(true) @map("pref_notificacion_email")

  hojas        HojaPrimerLlenado[]
  asignaciones Asignacion[]
  documentos   Documento[]
  expedientesQx ExpedienteQuirurgico[]
  prescripciones HojaPrescripcion[]
  hojasOrdenes   HojaOrdenes[]
  hojasConsumo   HojaConsumo[]
  valoracionesPreanestesicas ValoracionPreanestesica[]
  registrosAnestesicos       RegistroAnestesico[]
  notasPostanestesicas       NotaPostanestesica[]
  cuentaPortal               Usuario?
  aportaciones               AportacionPaciente[]
  invitacionesPortal         InvitacionPortal[]

  @@index([nombre, apellidoPaterno])
  @@index([curp])
  @@index([workspaceId])
  @@map("paciente")
}

enum EstadoHoja {
  BORRADOR
  CERRADA
}

model HojaPrimerLlenado {
  id         String   @id @default(uuid()) @db.Uuid
  pacienteId String   @map("paciente_id") @db.Uuid
  paciente   Paciente @relation(fields: [pacienteId], references: [id])
  version    Int      @default(1)

  motivoConsulta     String? @map("motivo_consulta")
  padecimientoActual String? @map("padecimiento_actual")
  especialidadesSugeridas String? @map("especialidades_sugeridas")

  antecedentesHeredofamiliares String? @map("antecedentes_heredofamiliares")
  antecedentesPatologicos      String? @map("antecedentes_personales_patologicos")
  antecedentesNoPatologicos    String? @map("antecedentes_personales_no_patologicos")
  antecedentesGinecoObstetricos String? @map("antecedentes_gineco_obstetricos")
  alergias             String? // "NINGUNA CONOCIDA" explícito
  medicamentosActuales String? @map("medicamentos_actuales")
  interrogatorioAparatos String? @map("interrogatorio_aparatos_sistemas")
  cirugiaDeseada       String? @map("cirugia_deseada")
  presupuesto          String?
  fechaProgramadaDeseada String? @map("fecha_programada_deseada")

  taSistolica  Int?     @map("ta_sistolica")
  taDiastolica Int?     @map("ta_diastolica")
  fc           Int?
  fr           Int?
  temperatura  Decimal? @db.Decimal(4, 1)
  pesoKg       Decimal? @map("peso_kg") @db.Decimal(5, 1)
  tallaCm      Decimal? @map("talla_cm") @db.Decimal(5, 1)
  spo2         Int?
  glucosa      Int?
  escalaDolor  Int?     @map("escala_dolor")

  observacionesEnfermeria String? @map("observaciones_enfermeria")
  estado            EstadoHoja @default(BORRADOR)
  disponibleConsulta Boolean   @default(false) @map("disponible_consulta")
  capturadoPorId    String     @map("capturado_por") @db.Uuid
  capturadoPor      Usuario    @relation("capturista", fields: [capturadoPorId], references: [id])
  fechaHoraCaptura  DateTime   @default(now()) @map("fecha_hora_captura")
  fechaCierre       DateTime?  @map("fecha_cierre")

  @@index([pacienteId])
  @@index([disponibleConsulta])
  @@map("hoja_primer_llenado")
}

// ─────────────────────────── Asignación ───────────────────────────

enum EstadoAsignacion {
  ACTIVA
  ALTA
  REFERIDA
  CANCELADA
}

model Asignacion {
  id              String   @id @default(uuid()) @db.Uuid
  pacienteId      String   @map("paciente_id") @db.Uuid
  paciente        Paciente @relation(fields: [pacienteId], references: [id])
  especialidadId  String   @map("especialidad_id") @db.Uuid
  especialidad    Especialidad @relation(fields: [especialidadId], references: [id])
  doctorId        String   @map("doctor_id") @db.Uuid
  doctor          Doctor   @relation(fields: [doctorId], references: [id])
  fechaAsignacion DateTime @default(now()) @map("fecha_asignacion")
  motivo          String?
  estado          EstadoAsignacion @default(ACTIVA)
  fechaCierre     DateTime? @map("fecha_cierre")

  notas         NotaEvolucion[]
  recetas       Receta[]
  expedientesQx ExpedienteQuirurgico[]
  citas         CitaPostoperatoria[]
  prescripciones HojaPrescripcion[]
  hojasOrdenes   HojaOrdenes[]

  @@index([doctorId, estado])
  @@index([pacienteId, estado])
  @@map("asignacion")
}

// ─────────────────────────── Notas de evolución ───────────────────────────

enum EstadoNota {
  BORRADOR
  FIRMADA
  CANCELADA
}

model NotaEvolucion {
  id            String     @id @default(uuid()) @db.Uuid
  asignacionId  String     @map("asignacion_id") @db.Uuid
  asignacion    Asignacion @relation(fields: [asignacionId], references: [id])
  fechaHora     DateTime   @default(now()) @map("fecha_hora")
  subjetivo     String?    // S
  objetivo      String?    // O — exploración
  signosVitales Json?      @map("signos_vitales")
  resultadosEstudios String? @map("resultados_estudios")
  diagnosticos  String?    // A
  pronostico    String?
  planTratamiento String?  @map("plan_tratamiento") // P — vía, dosis, periodicidad
  elaboradaPorId String    @map("elaborada_por") @db.Uuid
  elaboradaPor   Usuario   @relation(fields: [elaboradaPorId], references: [id])
  estado        EstadoNota @default(BORRADOR)
  fechaFirma    DateTime?  @map("fecha_firma")
  motivoCancelacion String? @map("motivo_cancelacion")
  notaPadreId   String?    @map("nota_padre_id") @db.Uuid
  notaPadre     NotaEvolucion?  @relation("adenda", fields: [notaPadreId], references: [id])
  adendas       NotaEvolucion[] @relation("adenda")
  recetas       Receta[]
  citas         CitaPostoperatoria[]

  @@index([asignacionId])
  @@map("nota_evolucion")
}

// ─────────────────────────── Recetas ───────────────────────────

enum EstadoReceta {
  EMITIDA
  CANCELADA
}

enum EstadoEnvio {
  PENDIENTE
  ENVIADA
  ERROR
  SIN_CORREO
}

model Receta {
  id              String     @id @default(uuid()) @db.Uuid
  folio           String     @unique
  asignacionId    String     @map("asignacion_id") @db.Uuid
  asignacion      Asignacion @relation(fields: [asignacionId], references: [id])
  notaEvolucionId String?    @map("nota_evolucion_id") @db.Uuid
  notaEvolucion   NotaEvolucion? @relation(fields: [notaEvolucionId], references: [id])
  fechaEmision    DateTime   @default(now()) @map("fecha_emision")
  diagnostico     String?
  indicacionesGenerales String? @map("indicaciones_generales")
  proximaCita     String?    @map("proxima_cita")
  snapshotMedico  Json       @map("snapshot_medico")
  snapshotPaciente Json      @map("snapshot_paciente")
  documentoId     String?    @map("documento_id") @db.Uuid
  documento       Documento? @relation(fields: [documentoId], references: [id])
  estadoEnvio     EstadoEnvio @default(PENDIENTE) @map("estado_envio")
  fechaEnvioEmail DateTime?  @map("fecha_envio_email")
  estado          EstadoReceta @default(EMITIDA)
  motivoCancelacion String?  @map("motivo_cancelacion")

  partidas  RecetaPartida[]
  emailQueue EmailQueue[]

  @@map("receta")
}

model RecetaPartida {
  id                String @id @default(uuid()) @db.Uuid
  recetaId          String @map("receta_id") @db.Uuid
  receta            Receta @relation(fields: [recetaId], references: [id])
  orden             Int
  medicamento       String // denominación genérica (+ distintiva opcional)
  presentacion      String?
  dosis             String
  viaAdministracion String @map("via_administracion")
  frecuencia        String
  duracion          String
  cantidad          String?
  indicaciones      String?

  @@index([recetaId])
  @@map("receta_partida")
}

// ─────────────────────────── Expediente quirúrgico ───────────────────────────

enum EstadoQx {
  PREOPERATORIO
  REALIZADA
  CANCELADA
}

model ExpedienteQuirurgico {
  id           String     @id @default(uuid()) @db.Uuid
  asignacionId String     @map("asignacion_id") @db.Uuid
  asignacion   Asignacion @relation(fields: [asignacionId], references: [id])
  pacienteId   String     @map("paciente_id") @db.Uuid
  paciente     Paciente   @relation(fields: [pacienteId], references: [id])
  fechaCirugiaProgramada DateTime? @map("fecha_cirugia_programada")
  quirofanoSede String?   @map("quirofano_sede")
  estado       EstadoQx   @default(PREOPERATORIO)
  createdAt    DateTime   @default(now()) @map("created_at")

  notaPre  NotaPreoperatoria?
  notaPost NotaPostoperatoria?
  citas    CitaPostoperatoria[]
  consentimientoDocId String? @map("consentimiento_doc_id") @db.Uuid
  consentimientoFecha DateTime? @map("consentimiento_fecha")

  hojasConsumo    HojaConsumo[]
  valoracionPre   ValoracionPreanestesica?
  registroAnestesico RegistroAnestesico?
  notaPostanestesica NotaPostanestesica?

  @@map("expediente_quirurgico")
}

model NotaPreoperatoria {
  id           String @id @default(uuid()) @db.Uuid
  expedienteId String @unique @map("expediente_qx_id") @db.Uuid
  expediente   ExpedienteQuirurgico @relation(fields: [expedienteId], references: [id])
  fechaHora    DateTime @default(now()) @map("fecha_hora")
  diagnosticoPreoperatorio String? @map("diagnostico_preoperatorio")
  planQuirurgico   String? @map("plan_quirurgico")
  tipoCirugia      String? @map("tipo_cirugia") // programada | urgencia
  riesgoQuirurgico String? @map("riesgo_quirurgico") // ASA + justificación
  cuidadosPlanTerapeutico String? @map("cuidados_y_plan_terapeutico")
  pronostico       String?
  elaboradaPorId   String  @map("elaborada_por") @db.Uuid
  estado           EstadoNota @default(BORRADOR)
  fechaFirma       DateTime? @map("fecha_firma")

  @@map("nota_preoperatoria")
}

model NotaPostoperatoria {
  id           String @id @default(uuid()) @db.Uuid
  expedienteId String @unique @map("expediente_qx_id") @db.Uuid
  expediente   ExpedienteQuirurgico @relation(fields: [expedienteId], references: [id])
  fechaHora    DateTime @default(now()) @map("fecha_hora")
  diagnosticoPreoperatorio String? @map("diagnostico_preoperatorio")
  operacionPlaneada   String? @map("operacion_planeada")
  operacionRealizada  String? @map("operacion_realizada")
  diagnosticoPostoperatorio String? @map("diagnostico_postoperatorio")
  descripcionTecnica  String? @map("descripcion_tecnica_quirurgica")
  hallazgos           String? @map("hallazgos_transoperatorios")
  conteoGasas         String? @map("reporte_conteo_gasas_compresas_instrumental")
  incidentesAccidentes String? @map("incidentes_accidentes")
  cuantificacionSangrado String? @map("cuantificacion_sangrado")
  transfusiones       String?
  estudiosTransoperatorios String? @map("estudios_transoperatorios")
  equipoQuirurgico    String? @map("ayudantes_anestesiologo_enfermeria")
  estadoPostquirurgico String? @map("estado_postquirurgico_inmediato")
  planManejo          String? @map("plan_manejo_tratamiento")
  pronostico          String?
  envioPiezasPatologia String? @map("envio_piezas_patologia")
  elaboradaPorId      String  @map("elaborada_por") @db.Uuid
  estado              EstadoNota @default(BORRADOR)
  fechaFirma          DateTime? @map("fecha_firma")

  @@map("nota_postoperatoria")
}

// ─────────────────────────── Citas postoperatorias ───────────────────────────

enum EstadoCita {
  PROGRAMADA
  REALIZADA
  NO_ASISTIO
  REPROGRAMADA
  CANCELADA
}

model CitaPostoperatoria {
  id           String @id @default(uuid()) @db.Uuid
  expedienteQxId String @map("expediente_quirurgico_id") @db.Uuid
  expedienteQx ExpedienteQuirurgico @relation(fields: [expedienteQxId], references: [id])
  asignacionId String @map("asignacion_id") @db.Uuid
  asignacion   Asignacion @relation(fields: [asignacionId], references: [id])
  fechaHoraProgramada DateTime @map("fecha_hora_programada")
  motivo       String
  estado       EstadoCita @default(PROGRAMADA)
  notaEvolucionId String? @map("nota_evolucion_id") @db.Uuid
  notaEvolucion NotaEvolucion? @relation(fields: [notaEvolucionId], references: [id])
  observaciones String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([fechaHoraProgramada])
  @@map("cita_postoperatoria")
}

// ─────────────────────────── Documentos, cola, bitácora ───────────────────────────

enum TipoDocumento {
  RECETA
  CONSENTIMIENTO
  CONSENTIMIENTO_ANESTESIA
  AUTORIZACION_QX
  HISTORIA_CLINICA
  NOTA_EVOLUCION
  NOTA_QUIRURGICA
  ESTUDIO
  RESUMEN_CLINICO
  OTRO
  FICHA_IDENTIFICACION
  PRESCRIPCION
  ORDENES_MEDICAS
  DESCRIPCION_QX
  CONSUMO_QUIROFANO
  CONSUMO_PISO
  VALORACION_PREANESTESICA
  REGISTRO_ANESTESICO
  NOTA_POSTANESTESICA
}

enum DocumentoOrigen {
  STAFF
  PACIENTE
}

model Documento {
  id            String   @id @default(uuid()) @db.Uuid
  pacienteId    String   @map("paciente_id") @db.Uuid
  paciente      Paciente @relation(fields: [pacienteId], references: [id])
  tipo          TipoDocumento
  nombreArchivo String   @map("nombre_archivo")
  ruta          String   @map("ruta_o_clave_almacenamiento")
  hashSha256    String   @map("hash_sha256")
  subidoPorId   String   @map("subido_por") @db.Uuid
  origen        DocumentoOrigen @default(STAFF) // distingue adjuntos subidos por el propio paciente vía portal
  fecha         DateTime @default(now())

  recetas Receta[]

  @@index([pacienteId])
  @@map("documento")
}

enum EstadoEmail {
  PENDIENTE
  ENVIADO
  FALLIDO
}

model EmailQueue {
  id            String   @id @default(uuid()) @db.Uuid
  recetaId      String   @map("receta_id") @db.Uuid
  receta        Receta   @relation(fields: [recetaId], references: [id])
  destinatario  String
  intentos      Int      @default(0)
  proximoIntento DateTime @default(now()) @map("proximo_intento")
  estado        EstadoEmail @default(PENDIENTE)
  ultimoError   String?  @map("ultimo_error")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([estado, proximoIntento])
  @@map("email_queue")
}

model Bitacora {
  id           BigInt   @id @default(autoincrement())
  usuarioId    String?  @map("usuario_id") @db.Uuid
  usuario      Usuario? @relation(fields: [usuarioId], references: [id])
  rolSnapshot  String?  @map("rol_snapshot")
  accion       String   // CREAR, FIRMAR, ADENDAR, CANCELAR, LOGIN, LOGIN_FALLIDO, CONSULTAR_EXPEDIENTE, ENVIAR_RECETA...
  entidad      String
  entidadId    String?  @map("entidad_id")
  pacienteId   String?  @map("paciente_id") @db.Uuid
  datosAntes   Json?    @map("datos_antes")
  datosDespues Json?    @map("datos_despues")
  ipOrigen     String?  @map("ip_origen")
  fechaHora    DateTime @default(now()) @map("fecha_hora")

  @@index([pacienteId])
  @@index([usuarioId])
  @@index([fechaHora])
  @@map("bitacora")
}

model Configuracion {
  id          Int     @id @default(1)
  razonSocial String  @default("MIT — Medical Tower") @map("razon_social")
  domicilio   String  @default("")
  telefono    String  @default("")
  logotipo    String? // data-URL
  emailRemitente String @default("onboarding@resend.dev") @map("email_remitente")
  // Datos que la papelería oficial imprime en el encabezado de cada formato.
  licenciaSanitaria String? @map("licencia_sanitaria")
  rfc               String?
  expedienteCofepris String? @map("expediente_cofepris")
  oficioCofepris     String? @map("oficio_cofepris")

  @@map("configuracion")
}

// ─────────── Prescripción médica de medicamentos (hoja oficial 1) ───────────
// Hoja de indicaciones farmacológicas del paciente hospitalizado: cuarto, dieta y
// renglones fecha / medicamento / dosis / vía / horario. Distinta de `Receta`,
// que es la prescripción ambulatoria con folio y envío por correo.

model HojaPrescripcion {
  id           String     @id @default(uuid()) @db.Uuid
  pacienteId   String     @map("paciente_id") @db.Uuid
  paciente     Paciente   @relation(fields: [pacienteId], references: [id])
  asignacionId String     @map("asignacion_id") @db.Uuid
  asignacion   Asignacion @relation(fields: [asignacionId], references: [id])
  cuarto       String?
  diagnostico  String?
  dieta        String?
  elaboradaPorId String   @map("elaborada_por") @db.Uuid
  elaboradaPor   Usuario  @relation("prescriptor", fields: [elaboradaPorId], references: [id])
  estado       EstadoNota @default(BORRADOR)
  fechaHora    DateTime   @default(now()) @map("fecha_hora")
  fechaFirma   DateTime?  @map("fecha_firma")

  partidas PrescripcionPartida[]

  @@index([pacienteId])
  @@map("hoja_prescripcion")
}

model PrescripcionPartida {
  id          String   @id @default(uuid()) @db.Uuid
  hojaId      String   @map("hoja_prescripcion_id") @db.Uuid
  hoja        HojaPrescripcion @relation(fields: [hojaId], references: [id])
  orden       Int
  fecha       DateTime @db.Date
  medicamento String
  dosis       String
  via         String
  horario     String

  @@index([hojaId])
  @@map("prescripcion_partida")
}

// ─────────── Hoja de órdenes médicas (hojas oficiales 9-10) ───────────

enum CategoriaOrden {
  DIETA
  CUIDADOS
  SOLUCIONES
  MEDICAMENTOS
  ESTUDIOS
  OTRO
}

model HojaOrdenes {
  id           String     @id @default(uuid()) @db.Uuid
  pacienteId   String     @map("paciente_id") @db.Uuid
  paciente     Paciente   @relation(fields: [pacienteId], references: [id])
  asignacionId String     @map("asignacion_id") @db.Uuid
  asignacion   Asignacion @relation(fields: [asignacionId], references: [id])
  fechaHora    DateTime   @default(now()) @map("fecha_hora")
  cuarto       String?
  elaboradaPorId String   @map("elaborada_por") @db.Uuid
  elaboradaPor   Usuario  @relation("ordenante", fields: [elaboradaPorId], references: [id])
  estado       EstadoNota @default(BORRADOR)
  fechaFirma   DateTime?  @map("fecha_firma")

  partidas OrdenPartida[]

  @@index([pacienteId])
  @@map("hoja_ordenes_medicas")
}

model OrdenPartida {
  id        String         @id @default(uuid()) @db.Uuid
  hojaId    String         @map("hoja_ordenes_id") @db.Uuid
  hoja      HojaOrdenes    @relation(fields: [hojaId], references: [id])
  orden     Int
  categoria CategoriaOrden @default(OTRO)
  texto     String

  @@index([hojaId])
  @@map("orden_partida")
}

// ─────────── Hojas de consumo en quirófano y de piso (hojas oficiales 11-14) ───────────

enum CategoriaInsumo {
  MATERIAL
  MEDICAMENTO
  SUTURA
  SOLUCION
  OTRO
  SERVICIO
}

enum TipoConsumo {
  QUIROFANO
  PISO
}

// Catálogo de insumos cobrables con su precio vigente (lo administra el ADMIN).
model Insumo {
  id        String          @id @default(uuid()) @db.Uuid
  clave     String?
  nombre    String
  categoria CategoriaInsumo
  precio    Decimal         @default(0) @db.Decimal(12, 2)
  orden     Int             @default(0)
  activo    Boolean         @default(true)
  createdAt DateTime        @default(now()) @map("created_at")

  partidas ConsumoPartida[]

  @@unique([categoria, nombre])
  @@index([categoria, orden])
  @@map("insumo")
}

model HojaConsumo {
  id             String      @id @default(uuid()) @db.Uuid
  pacienteId     String      @map("paciente_id") @db.Uuid
  paciente       Paciente    @relation(fields: [pacienteId], references: [id])
  expedienteQxId String?     @map("expediente_quirurgico_id") @db.Uuid
  expedienteQx   ExpedienteQuirurgico? @relation(fields: [expedienteQxId], references: [id])
  tipo           TipoConsumo

  cuarto      String?
  tratamiento String?
  procedimiento String?
  fechaIngreso  DateTime? @map("fecha_ingreso")
  fechaEgreso   DateTime? @map("fecha_egreso")
  horaIngresoQuirofano String? @map("hora_ingreso_quirofano")
  horaTerminoQuirofano String? @map("hora_termino_quirofano")
  turno         String?

  medicoPediatra      String? @map("medico_pediatra")
  medicoTratante      String? @map("medico_tratante")
  medicoCirujano      String? @map("medico_cirujano")
  medicoAnestesiologo String? @map("medico_anestesiologo")
  medicoAyudante      String? @map("medico_ayudante")
  enfermera           String?
  instrumentista      String?

  capturadoPorId String     @map("capturado_por") @db.Uuid
  capturadoPor   Usuario    @relation("consumoCapturista", fields: [capturadoPorId], references: [id])
  estado         EstadoHoja @default(BORRADOR)
  fechaCierre    DateTime?  @map("fecha_cierre")
  createdAt      DateTime   @default(now()) @map("created_at")

  partidas ConsumoPartida[]

  @@index([pacienteId])
  @@index([expedienteQxId])
  @@map("hoja_consumo")
}

model ConsumoPartida {
  id             String          @id @default(uuid()) @db.Uuid
  hojaId         String          @map("hoja_consumo_id") @db.Uuid
  hoja           HojaConsumo     @relation(fields: [hojaId], references: [id])
  insumoId       String?         @map("insumo_id") @db.Uuid
  insumo         Insumo?         @relation(fields: [insumoId], references: [id])
  descripcion    String
  categoria      CategoriaInsumo
  cantidad       Decimal         @default(1) @db.Decimal(10, 2)
  precioUnitario Decimal         @default(0) @map("precio_unitario") @db.Decimal(12, 2)
  importe        Decimal         @default(0) @db.Decimal(12, 2)
  // Sólo la hoja de piso registra fecha, enfermera y observaciones por renglón.
  fecha          DateTime?       @db.Date
  enfermera      String?
  observaciones  String?
  orden          Int             @default(0)

  @@index([hojaId])
  @@map("consumo_partida")
}

// ─────────── Anestesiología (hojas oficiales 15-20) ───────────

// Hojas 15-16: valoración preanestésica y valoración de factores de riesgo.
// Los bloques de casillas del formato (ASA, Goldman, riesgo trombolítico, vía
// aérea difícil, Glasgow, plan anestésico) se guardan en JSON porque son
// listas de verificación con puntajes, no datos consultables por separado.
model ValoracionPreanestesica {
  id             String   @id @default(uuid()) @db.Uuid
  expedienteQxId String   @unique @map("expediente_quirurgico_id") @db.Uuid
  expedienteQx   ExpedienteQuirurgico @relation(fields: [expedienteQxId], references: [id])
  pacienteId     String   @map("paciente_id") @db.Uuid
  paciente       Paciente @relation(fields: [pacienteId], references: [id])

  habitacion   String?
  servicio     String?
  folio        String?
  tipoPago     String? @map("tipo_pago") // SEGURO | PARTICULAR
  fechaIngreso DateTime? @map("fecha_ingreso")
  horaIngreso  String?   @map("hora_ingreso")

  diagnosticoPrequirurgico String? @map("diagnostico_prequirurgico")
  cirugiaPlaneada          String? @map("cirugia_planeada")
  cirujano                 String?
  anestesiologo            String?
  tipoCirugia              Json?   @map("tipo_cirugia") // mayor/menor/ambulatoria/urgencia/electiva/reintervencion
  antecedentesImportancia  String? @map("antecedentes_importancia")

  pesoKg  Decimal? @map("peso_kg") @db.Decimal(5, 1)
  tallaCm Decimal? @map("talla_cm") @db.Decimal(5, 1)
  imc     Decimal? @db.Decimal(5, 2)

  temperatura Decimal? @db.Decimal(4, 1)
  ta          String?
  fr          Int?
  fc          Int?
  spo2        Int?

  exCabeza          String? @map("ex_cabeza")
  exCuello          String? @map("ex_cuello")
  exRespiratorio    String? @map("ex_respiratorio")
  exCardiovascular  String? @map("ex_cardiovascular")
  exGastrointestinal String? @map("ex_gastrointestinal")
  exGenitourinario  String? @map("ex_genitourinario")

  labFecha       DateTime? @map("lab_fecha")
  grupoSanguineo String?   @map("grupo_sanguineo")
  factorRh       String?   @map("factor_rh")
  hemoglobina  String?
  hematocrito  String?
  plaquetas    String?
  leucocitos   String?
  tp           String?
  tpt          String?
  tt           String?
  glucosa      String?
  creatinina   String?
  urea         String?
  sodio        String?
  potasio      String?
  cloro        String?
  calcio       String?
  labOtros     String? @map("lab_otros")

  ecg           String?
  rayosX        String? @map("rayos_x")
  ultrasonido   String?
  gabineteOtros String? @map("gabinete_otros")

  factoresRiesgo   Json? @map("factores_riesgo")   // tabaquismo, alcoholismo, alergias, anestesias previas…
  asa              String?
  anginaCanadiense String? @map("angina_canadiense")
  goldman          Json?   // variables de Goldman marcadas
  predictores      Json?   // predictores de enfermedad arterial coronaria por nivel
  goldmanPuntos    Int?    @map("goldman_puntos")
  goldmanClase     String? @map("goldman_clase")
  trombolitico     Json?   // predictores menores/intermedios/mayores + subtotales + riesgo total
  neurologico      Json?   // pupilas + Glasgow (ojos, motor, verbal, total)
  viaAerea         Json?   @map("via_aerea") // Mallampati, tiromentoniana, subluxación, apertura
  planAnestesico   Json?   @map("plan_anestesico")

  fechaElaboracion   DateTime?  @map("fecha_elaboracion")
  anestesiologoId    String     @map("anestesiologo_id") @db.Uuid
  anestesiologoUsuario Usuario  @relation("anestesiologoValoracion", fields: [anestesiologoId], references: [id])
  firmaAnestesiologo String?    @map("firma_anestesiologo") // data-URL rúbrica
  estado             EstadoNota @default(BORRADOR)
  fechaFirma         DateTime?  @map("fecha_firma")

  @@index([pacienteId])
  @@map("valoracion_preanestesica")
}

// Hojas 17, 18 y 20: evaluación inmediata previa, registro anestésico y
// registro transanestésico (gráfica de signos vitales y balance hídrico).
model RegistroAnestesico {
  id             String   @id @default(uuid()) @db.Uuid
  expedienteQxId String   @unique @map("expediente_quirurgico_id") @db.Uuid
  expedienteQx   ExpedienteQuirurgico @relation(fields: [expedienteQxId], references: [id])
  pacienteId     String   @map("paciente_id") @db.Uuid
  paciente       Paciente @relation(fields: [pacienteId], references: [id])

  evalFecha                 DateTime? @map("eval_fecha")
  evalHora                  String?   @map("eval_hora")
  consentimientoAnestesia   Boolean?  @map("consentimiento_anestesia")
  identificacionCorroborada Boolean?  @map("identificacion_corroborada")
  verificacionEquipo        Json?     @map("verificacion_equipo")
  signosBasales             Json?     @map("signos_basales")
  medicacionPreanestesica   Json?     @map("medicacion_preanestesica")
  evalObservaciones         String?   @map("eval_observaciones")

  horasAyuno            String?  @map("horas_ayuno")
  premedicacion         Boolean?
  premedicacionDetalle  String?  @map("premedicacion_detalle")
  accesoVenoso          Boolean? @map("acceso_venoso")
  accesoSitio           String?  @map("acceso_sitio")
  calibreCateter        String?  @map("calibre_cateter")
  posicionPaciente      String?  @map("posicion_paciente")
  posicionBrazos        String?  @map("posicion_brazos")
  proteccionOjos        Boolean? @map("proteccion_ojos")
  proteccionProminencias Boolean? @map("proteccion_prominencias")
  torniquete            Boolean?
  torniqueteSitio       String?  @map("torniquete_sitio")
  torniqueteInicia      String?  @map("torniquete_inicia")
  torniqueteTermina     String?  @map("torniquete_termina")
  tecnicaAnestesica     String?  @map("tecnica_anestesica")
  anestesiaLocal        Json?    @map("anestesia_local")
  anestesiaRegional     Json?    @map("anestesia_regional")
  anestesiaGeneral      Json?    @map("anestesia_general")
  casoObstetrico        Json?    @map("caso_obstetrico")

  agentes         String?
  tiempos         Json?   // ingreso, inicio/final anestesia, inicio/final cirugía, recuperación
  tipoVentilacion String? @map("tipo_ventilacion")
  egresos         Json?   // pérdidas insensibles, ayuno, exposición qx, diuresis, sangrado
  ingresos        Json?   // cristaloides, coloides, sangre, plasma
  balanceHidrico  String? @map("balance_hidrico")
  aldreteFinal    Int?    @map("aldrete_final")
  pasaA           String? @map("pasa_a")

  anestesiologoId      String     @map("anestesiologo_id") @db.Uuid
  anestesiologoUsuario Usuario    @relation("anestesiologoRegistro", fields: [anestesiologoId], references: [id])
  firmaAnestesiologo   String?    @map("firma_anestesiologo")
  estado               EstadoNota @default(BORRADOR)
  fechaFirma           DateTime?  @map("fecha_firma")

  lecturas TransanestesicoLectura[]
  farmacos TransanestesicoFarmaco[]

  @@index([pacienteId])
  @@map("registro_anestesico")
}

// Cada columna de la cuadrícula del registro transanestésico (un punto en el tiempo).
model TransanestesicoLectura {
  id           String   @id @default(uuid()) @db.Uuid
  registroId   String   @map("registro_anestesico_id") @db.Uuid
  registro     RegistroAnestesico @relation(fields: [registroId], references: [id])
  minuto       Int      // minutos desde el inicio del registro
  hora         String?
  taSistolica  Int?     @map("ta_sistolica")
  taDiastolica Int?     @map("ta_diastolica")
  fc           Int?
  fr           Int?
  temperatura  Decimal? @db.Decimal(4, 1)
  spo2         Int?
  etco2        String?
  pvcPam       String?  @map("pvc_pam")
  bis          String?
  otros        String?

  @@unique([registroId, minuto])
  @@map("transanestesico_lectura")
}

model TransanestesicoFarmaco {
  id           String @id @default(uuid()) @db.Uuid
  registroId   String @map("registro_anestesico_id") @db.Uuid
  registro     RegistroAnestesico @relation(fields: [registroId], references: [id])
  orden        Int
  nombre       String
  dosis        String?
  via          String?
  aplicaciones Json?  // [{ minuto, cantidad }]

  @@index([registroId])
  @@map("transanestesico_farmaco")
}

// Hoja 19: recuperación anestésica (Aldrete, Ramsay, Bromage) + nota y plan post-anestésico.
model NotaPostanestesica {
  id             String   @id @default(uuid()) @db.Uuid
  expedienteQxId String   @unique @map("expediente_quirurgico_id") @db.Uuid
  expedienteQx   ExpedienteQuirurgico @relation(fields: [expedienteQxId], references: [id])
  pacienteId     String   @map("paciente_id") @db.Uuid
  paciente       Paciente @relation(fields: [pacienteId], references: [id])

  aldrete Json?   // { "0": {actividad, respiracion, circulacion, conciencia, saturacion, total}, "5": {…} }
  ramsay  Int?
  bromage Int?
  nota    String?

  planOxigeno               String? @map("plan_oxigeno")
  planSolucionesIV          String? @map("plan_soluciones_iv")
  planMedicamentos          String? @map("plan_medicamentos")
  planComponentesSanguineos String? @map("plan_componentes_sanguineos")
  planManejoDolor           String? @map("plan_manejo_dolor")

  motivoEgreso String?  @map("motivo_egreso")
  pasaA        String?  @map("pasa_a")
  fechaHora    DateTime @default(now()) @map("fecha_hora")

  anestesiologoId      String     @map("anestesiologo_id") @db.Uuid
  anestesiologoUsuario Usuario    @relation("anestesiologoPostanestesica", fields: [anestesiologoId], references: [id])
  firmaAnestesiologo   String?    @map("firma_anestesiologo")
  estado               EstadoNota @default(BORRADOR)
  fechaFirma           DateTime?  @map("fecha_firma")

  @@index([pacienteId])
  @@map("nota_postanestesica")
}

// ─────────────────────────── Portal del paciente ───────────────────────────
// Información aportada por el paciente (alergias, medicamentos, antecedentes,
// síntomas, observaciones, preconsulta): nunca escribe directamente sobre
// HojaPrimerLlenado ni NotaEvolucion (protegidas por trigger de inmutabilidad);
// el profesional de salud la revisa y decide si la incorpora a su propia nota.

enum CategoriaAporte {
  ALERGIA
  MEDICAMENTO
  ANTECEDENTE
  SINTOMA
  OBSERVACION
  PRECONSULTA
}

enum EstadoAporte {
  PENDIENTE_REVISION
  INCORPORADA
  RECHAZADA
}

model AportacionPaciente {
  id            String          @id @default(uuid()) @db.Uuid
  pacienteId    String          @map("paciente_id") @db.Uuid
  paciente      Paciente        @relation(fields: [pacienteId], references: [id])
  categoria     CategoriaAporte
  contenido     String
  estado        EstadoAporte    @default(PENDIENTE_REVISION)
  creadoPorId   String          @map("creado_por") @db.Uuid // Usuario.id (rol PACIENTE) del autor
  revisadoPorId String?         @map("revisado_por") @db.Uuid // Usuario.id del profesional que revisó
  notaRevisor   String?         @map("nota_revisor")
  revisadoEn    DateTime?       @map("revisado_en")
  createdAt     DateTime        @default(now()) @map("created_at")

  @@index([pacienteId, estado])
  @@map("aportacion_paciente")
}

// Invitación de un solo uso para activar la cuenta de portal de un Paciente ya
// existente (no hay auto-registro abierto de pacientes, a diferencia de /registro
// para médicos BASIC). El token se guarda hasheado; el que se envía por correo no
// se persiste nunca en claro.
model InvitacionPortal {
  id          String    @id @default(uuid()) @db.Uuid
  pacienteId  String    @map("paciente_id") @db.Uuid
  paciente    Paciente  @relation(fields: [pacienteId], references: [id])
  email       String    // correo exacto al que se envió; se fija como login al activar
  tokenHash   String    @unique @map("token_hash")
  creadoPorId String    @map("creado_por") @db.Uuid // Usuario.id del staff que invitó
  expiresAt   DateTime  @map("expires_at")
  usadoEn     DateTime? @map("usado_en")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([pacienteId])
  @@map("invitacion_portal")
}
